<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="startup-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.medvora.desktopclient.controller.StartupController">
    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <!-- Decorative background canvas for subtle arcs -->
    <Pane fx:id="backgroundDecorationPane" mouseTransparent="true" />

    <!-- Main Vertical Layout -->
    <VBox alignment="CENTER" fillWidth="false">
        <!-- Top Spacer to achieve optical vertical centering -->
        <VBox VBox.vgrow="ALWAYS" />

        <!-- Centered Card -->
        <VBox alignment="CENTER" styleClass="startup-card">
            <!-- Brand Lockup: Logo + Text side-by-side -->
            <HBox alignment="CENTER" spacing="22">
                <ImageView fitHeight="76" preserveRatio="true" smooth="true">
                    <image>
                        <Image url="@../images/logo.png" />
                    </image>
                </ImageView>
                <VBox alignment="CENTER_LEFT" spacing="1">
                    <Label styleClass="startup-brand-title" text="Medvora" />
                    <Label styleClass="startup-brand-subtitle" text="Ready for care." />
                </VBox>
            </HBox>

            <!-- Loading Indicator & Status -->
            <VBox alignment="CENTER" spacing="18">
                <VBox.margin>
                    <Insets top="32" />
                </VBox.margin>
                <ProgressBar fx:id="progressBar" progress="0.38" styleClass="startup-progress-bar" />
                <Label styleClass="startup-status-label" text="Preparing your workspace..." />
            </VBox>
        </VBox>

        <!-- Bottom Spacer -->
        <VBox VBox.vgrow="ALWAYS" />

        <!-- Subtitle Footer -->
        <Label styleClass="startup-footer-label" text="Medicine inventory and replenishment">
            <VBox.margin>
                <Insets bottom="46" />
            </VBox.margin>
        </Label>
    </VBox>
</StackPane>