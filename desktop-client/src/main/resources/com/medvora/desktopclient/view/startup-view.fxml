<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="startup-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.medvora.desktopclient.controller.StartupController">
    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <!-- Decorative curved line overlays (top-right and bottom-left) -->
    <Region styleClass="startup-decor-top" StackPane.alignment="TOP_RIGHT" />
    <Region styleClass="startup-decor-bottom" StackPane.alignment="BOTTOM_LEFT" />

    <BorderPane>
        <!-- Center: the startup card -->
        <center>
            <VBox alignment="CENTER" maxHeight="260" maxWidth="380" spacing="20" styleClass="startup-card">
                <!-- Logo + Brand Name side by side -->
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="52" preserveRatio="true" styleClass="startup-logo">
                        <image>
                            <Image url="@../images/logo.png" />
                        </image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label styleClass="startup-brand-title" text="Medvora" />
                        <Label styleClass="startup-tagline" text="Ready for care." />
                    </VBox>
                </HBox>

                <!-- Progress bar -->
                <VBox alignment="CENTER" spacing="10">
                    <ProgressBar fx:id="progressBar" prefWidth="260" styleClass="startup-progress" />
                    <Label fx:id="statusLabel" styleClass="startup-status-text" text="Preparing your workspace..." />
                </VBox>
            </VBox>
        </center>

        <!-- Bottom footer text -->
        <bottom>
            <VBox alignment="CENTER">
                <padding>
                    <Insets bottom="28" />
                </padding>
                <Label styleClass="startup-footer-text" text="Medicine inventory and replenishment" />
            </VBox>
        </bottom>
    </BorderPane>
</StackPane>