<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="startup-background" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.medvora.desktopclient.controller.SignInController">
    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <!-- Decorative curved line overlays -->
    <Region styleClass="startup-decor-top" StackPane.alignment="TOP_RIGHT" />
    <Region styleClass="startup-decor-bottom" StackPane.alignment="BOTTOM_LEFT" />

    <BorderPane>
        <!-- Center: the sign-in card -->
        <center>
            <VBox alignment="CENTER" maxWidth="440" spacing="18" styleClass="signin-card">
                <!-- Logo + Brand Name side by side -->
                <HBox alignment="CENTER" spacing="10">
                    <ImageView fitHeight="52" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo.png" />
                        </image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label styleClass="startup-brand-title" text="Medvora" />
                        <Label styleClass="startup-tagline" text="Ready for care." />
                    </VBox>
                </HBox>

                <!-- Sign In heading and subtitle -->
                <VBox alignment="CENTER" spacing="6">
                    <Label styleClass="signin-heading" text="Sign In" />
                    <Label styleClass="signin-subtitle" text="Use your assigned account to continue." />
                </VBox>

                <!-- Username field -->
                <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="6">
                    <Label styleClass="field-label" text="Username" />
                    <TextField fx:id="usernameField" promptText="Enter your username" styleClass="text-input-field" />
                </VBox>

                <!-- Password field with toggle visibility -->
                <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="6">
                    <Label styleClass="field-label" text="Password" />
                    <StackPane>
                        <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="text-input-field" />
                        <TextField fx:id="passwordTextField" promptText="Enter your password" styleClass="text-input-field" visible="false" managed="false" />
                        <Button fx:id="togglePasswordBtn" onAction="#handleTogglePassword" styleClass="password-toggle-btn" StackPane.alignment="CENTER_RIGHT">
                            <graphic>
                                <Label fx:id="eyeIconLabel" text="👁" styleClass="eye-icon" />
                            </graphic>
                        </Button>
                    </StackPane>
                </VBox>

                <!-- Sign In button -->
                <Button maxWidth="Infinity" onAction="#handleSignIn" styleClass="btn-primary" text="Sign In" />

                <!-- Access Help link -->
                <Hyperlink fx:id="accessHelpLink" onAction="#handleAccessHelp" styleClass="link-action" text="Access Help" />

                <!-- Admin notice -->
                <Label styleClass="signin-admin-notice" text="Accounts are managed by your administrator." />
            </VBox>
        </center>

        <!-- Bottom footer -->
        <bottom>
            <VBox alignment="CENTER">
                <padding>
                    <Insets bottom="28" />
                </padding>
                <Label styleClass="startup-footer-text" text="Medicine inventory and replenishment" />
            </VBox>
        </bottom>
    </BorderPane>
</StackPane>